
body {
    font-family: Arial, sans-serif;
    margin: 0;
    background-color: #f2f5f9;
    color: #333;
}

header {
    background-color: #2457a7;
    color: white;
    text-align: center;
    padding: 25px;
}

nav {
    background-color: #183d78;
    padding: 15px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 15px;
}

nav a:hover {
    text-decoration: underline;
}

main {
    padding: 20px;
    max-width: 900px;
    margin: auto;
}

section {
    background-color: white;
    padding: 20px;
    margin-bottom: 20px;
    border-radius: 10px;
}

.card {
    background-color: #e5edfa;
    padding: 12px;
    margin: 10px 0;
    border-radius: 8px;
}

button {
    background-color: #2457a7;
    color: white;
    border: none;
    padding: 12px 18px;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background-color: #183d78;
}

footer {
    background-color: #183d78;
    color: white;
    text-align: center;
    padding: 15px;
}
